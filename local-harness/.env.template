# ─────────────────────────────────────────────────────────────────────────────
# Break-the-Model / Entropy red-team  —  environment config
# Copy this file to  .env  and paste your keys.  (.env is gitignored.)
#   cp .env.template .env
# Leave a value blank to disable that provider.
# ─────────────────────────────────────────────────────────────────────────────

# ========== 1) The hackathon Riley TARGET (the hosted assistant you attack) ==========
# Your challenge key for the hosted Riley server. A Groq key starts with "gsk_";
# a Nebius key does not — the server auto-detects which.
API_KEY=paste-your-challenge-key-here
API_URL=https://2-31-186-181.sslip.io
YOUR_NAME=pritsss


# ========== 2) Attacker-agent LLM provider (the swarm's own models) ==========
# The planner / attackers / mutator / evaluator run on ONE of these providers.
# Pick it at runtime:  --agent-backend groq | nebius | ollama

# ---- Groq (direct api.groq.com) ----
# If you leave GROQ_API_KEY blank, the agents reuse API_KEY above (works when your
# challenge key is a Groq key). Free tier is rate-limited (~8k tokens/min).
GROQ_API_KEY=
# GROQ_BASE_URL=https://api.groq.com/openai/v1   # (default; rarely needs changing)

# ---- Nebius Token Factory (OpenAI-compatible; roomier limits) ----
# Get a key at https://studio.nebius.com (Token Factory → API keys). Paste it here.
NEBIUS_API_KEY=paste-your-nebius-token-factory-key-here
NEBIUS_BASE_URL=https://api.studio.nebius.com/v1
# Models the swarm uses on Nebius (check the Nebius model catalog for exact ids):
NEBIUS_AGENT_MODEL=Qwen/Qwen3-30B-A3B
NEBIUS_EVAL_MODEL=meta-llama/Llama-3.3-70B-Instruct

# ---- Ollama (local models; no rate limit) ----
# No key needed. Used when --agent-backend ollama (defaults: qwen3:4b / dolphin3).
# OLLAMA_HOST=http://localhost:11434

# ─────────────────────────────────────────────────────────────────────────────
# Notes:
# • The TARGET Riley-Agent (riley_agent.py) runs on Groq gpt-oss-20b (needs tool
#   calls). Keep a Groq key available for the target even if agents use Nebius.
# • Run the swarm on Nebius:
#     python3 entropy_redteam.py --agent-backend nebius --rounds 3 --max-calls 150
# ─────────────────────────────────────────────────────────────────────────────
